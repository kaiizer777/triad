# OpenCode Zen Configuration for Triad
base_url: "https://opencode.ai/zen/v1"
api_key: "YOUR_OPENCODE_API_KEY"
model: "mimo-v2.5-free"

# Optional: cap run_command execution time (default: 30 seconds).
# Raise this if your build commands (e.g. go build on a large repo) take longer.
# command_timeout_seconds: 30

# Archive completed session transcripts older than this many days at startup.
# Archives are gzip files under sessions/archive/ and the active session is protected.
# session_retention_days: 30
# This same window also gzip-archives old raw memory/daily/*.md logs under
# memory/daily/archive/ at startup. Archives are retained indefinitely.

# Rotate triad.log before it exceeds this size, retaining this many backups.
# Defaults: 10 MiB and 5 backups (triad.log.1 through triad.log.5).
# log_max_bytes: 10485760
# log_max_backups: 5

# Run `git gc --auto` in the background after this many successful Triad
# auto-commits. Enabled by default; set git_gc_auto_enabled: false to disable.
# git_gc_auto_enabled: true
# git_gc_commit_interval: 50
